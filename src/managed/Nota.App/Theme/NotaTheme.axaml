<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  Nota design tokens + control styles — the Studio design language, after Saine (see
  DESIGN.md and .claude/skills/nota-design): neutral greys stepped on dark seams, one
  orange accent for what is live or chosen, in a dark (default) and a light variant.
  This file is the concrete source of truth for colors/geometry — views reference
  these keys, never hardcoded values.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Fonts: Geist for names and words, Geist Mono for every measurement.
           Bundled from assets/fonts (SIL OFL 1.1); mirrored by Theme/NotaFonts.cs. -->
      <FontFamily x:Key="Font.UI">avares://Nota.App/Assets/Fonts#Geist</FontFamily>
      <FontFamily x:Key="Font.Mono">avares://Nota.App/Assets/Fonts#Geist Mono</FontFamily>

      <!-- ===== Geometry ========================================================
           Mirrored in Theme/NotaGeometry.cs for code-built views; the smoke test
           keeps the two files equal.

           Radius follows the size of the object, not its role. -->
      <CornerRadius x:Key="Radius.Docked">0</CornerRadius>   <!-- a docked panel: it meets its neighbours on a seam -->
      <CornerRadius x:Key="Radius.Bar">1</CornerRadius>      <!-- spectrum / level bar inside a plot -->
      <CornerRadius x:Key="Radius.Clip">2</CornerRadius>     <!-- clip, row highlight, menu item, slider track -->
      <CornerRadius x:Key="Radius.Badge">2</CornerRadius>    <!-- inner key, badge inside a device -->
      <CornerRadius x:Key="Radius.Control">3</CornerRadius>  <!-- button, field, dropdown, graph window, popover -->
      <CornerRadius x:Key="Radius.Tile">3</CornerRadius>     <!-- transport key, search field, tile -->
      <CornerRadius x:Key="Radius.Panel">3</CornerRadius>    <!-- device section, segmented group -->
      <CornerRadius x:Key="Radius.Body">3</CornerRadius>     <!-- device card -->
      <CornerRadius x:Key="Radius.Pill">3</CornerRadius>     <!-- chip, switch: Saine has no pills -->
      <CornerRadius x:Key="Radius.Modal">4</CornerRadius>    <!-- modal window, command palette, splash -->   <!-- filter chip, toggle: half the height -->

      <!-- Heights and fixed widths already settled in the designs -->
      <sys:Double x:Key="Control.Chip">20</sys:Double>        <!-- filter chip -->
      <sys:Double x:Key="Control.Seg">24</sys:Double>         <!-- tab segment -->
      <sys:Double x:Key="Control.Shell">26</sys:Double>       <!-- shell button, field, dropdown -->
      <sys:Double x:Key="Control.SegGroup">30</sys:Double>    <!-- segment container: 24 + 2 pad + 1 border -->
      <sys:Double x:Key="Control.Transport">26</sys:Double>   <!-- transport key -->
      <sys:Double x:Key="Control.Play">36</sys:Double>        <!-- Play is the one wide transport key -->
      <sys:Double x:Key="Control.Console">30</sys:Double>     <!-- the recessed transport group inside the row -->
      <sys:Double x:Key="Control.TransportBar">44</sys:Double> <!-- the docked transport row -->
      <sys:Double x:Key="Control.KnobSecondary">34</sys:Double>
      <sys:Double x:Key="Control.KnobRegular">36</sys:Double>
      <sys:Double x:Key="Control.KnobMain">44</sys:Double>
      <sys:Double x:Key="Control.KnobInline">24</sys:Double>
      <sys:Double x:Key="Control.ParamCell">53</sys:Double>   <!-- knob 34 + label line 9 + value line 10 -->

      <!-- Spacing. Inside a device everything moves in 2px units, in the shell in 4px. -->
      <sys:Double x:Key="Space.DeviceHair">2</sys:Double>
      <sys:Double x:Key="Space.DeviceGap">5</sys:Double>      <!-- between device sections -->
      <sys:Double x:Key="Space.DeviceInset">6</sys:Double>    <!-- body padding, section inset -->
      <sys:Double x:Key="Space.DeviceInsetWide">8</sys:Double>
      <sys:Double x:Key="Space.Tile">8</sys:Double>           <!-- between tiles -->
      <sys:Double x:Key="Space.Gutter">1</sys:Double>         <!-- between docked panels: the seam -->
      <sys:Double x:Key="Space.Inset">20</sys:Double>         <!-- inside a shell panel -->

      <!-- ===== Palette =========================================================
           Two variants of one system: Saine's dark preset (the default) and its light
           preset — the same roles in light greys, the accent a shade darker so lines
           hold contrast on pale grey. Every value here MIRRORS a slot in
           Theme/NotaPalette.cs, which
           serves the custom-drawn layer; the two files must be edited together.

           These live in ThemeDictionaries, so views must reach them with
           {DynamicResource Brush.*} — a StaticResource cannot follow the variant. -->
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <!-- === Surfaces: Saine's grey ladder, far to near ===
               Well · Ground · Panel · Raised · Raised hover, plus a dark seam between
               panels. Depth is tone plus a 1px seam; only floating layers cast a
               shadow. -->
          <SolidColorBrush x:Key="Brush.SurfaceAbyss">#17181A</SolidColorBrush>  <!-- well: the transport console recess -->
          <SolidColorBrush x:Key="Brush.BgApp">#1E1F22</SolidColorBrush>         <!-- ground: window, arrangement, plugin body -->
          <SolidColorBrush x:Key="Brush.Gutter">#141517</SolidColorBrush>        <!-- seam: what the docked panels meet on -->
          <SolidColorBrush x:Key="Brush.BgSunken">#17181A</SolidColorBrush>      <!-- Well: graph windows, inputs, slider tracks -->
          <SolidColorBrush x:Key="Brush.Panel">#2B2D31</SolidColorBrush>         <!-- Panel: browser, headers, inspector -->
          <SolidColorBrush x:Key="Brush.SurfaceCard">#2B2D31</SolidColorBrush>   <!-- Card: a section inside a device -->
          <SolidColorBrush x:Key="Brush.SurfaceInset">#232427</SolidColorBrush>  <!-- between ground and panel: a hovered well, a sunken chip -->
          <SolidColorBrush x:Key="Brush.SurfaceRaised">#34363B</SolidColorBrush> <!-- Raised: button at rest -->
          <SolidColorBrush x:Key="Brush.SurfaceHover">#393C41</SolidColorBrush>  <!-- Hover: button or list row under the pointer -->
          <SolidColorBrush x:Key="Brush.SurfaceHoverClear">#00393C41</SolidColorBrush> <!-- Hover at zero alpha: resting row, so the fade doesn't pass through white -->
          <SolidColorBrush x:Key="Brush.TrackOff">#17181A</SolidColorBrush>      <!-- Track off: the track of an off toggle -->
          <!-- Pressed goes *into* the recess rather than to a fourth raised step. -->
          <SolidColorBrush x:Key="Brush.SurfaceActive">#17181A</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.LaneB">#222326</SolidColorBrush>         <!-- alternating lane, one hair above the well -->
          <SolidColorBrush x:Key="Brush.ChromeBg">#17181A</SolidColorBrush>      <!-- alias of Well -->
          <!-- Selected row: the raised-hover step; an accent tick marks it. -->
          <SolidColorBrush x:Key="Brush.SurfaceSelected">#393C41</SolidColorBrush>

          <!-- Lines and frames -->
          <SolidColorBrush x:Key="Brush.Hairline">#45484E</SolidColorBrush>      <!-- row dividers, graph-window frame -->
          <SolidColorBrush x:Key="Brush.BorderDefault">#141517</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.BorderStrong">#45484E</SolidColorBrush>  <!-- knob cap, hovered border -->
          <SolidColorBrush x:Key="Brush.BorderBrass">#BF7D22</SolidColorBrush>   <!-- accent line: 70% accent over the panel -->
          <SolidColorBrush x:Key="Brush.GridBeat">#2A2C30</SolidColorBrush>      <!-- grid inside graphs, zero axis -->
          <SolidColorBrush x:Key="Brush.GridBar">#3A3C41</SolidColorBrush>

          <!-- === Text: eight steps, strictly by descending importance === -->
          <SolidColorBrush x:Key="Brush.TextHeading">#F4F5F6</SolidColorBrush>   <!-- Ink 0: page titles, project name. Rare. -->
          <SolidColorBrush x:Key="Brush.TextPrimary">#E8E9EB</SolidColorBrush>   <!-- Ink 1: device, track and preset names, values -->
          <SolidColorBrush x:Key="Brush.TextStrong">#D4D6DA</SolidColorBrush>    <!-- Ink 2: button text, transport readouts -->
          <SolidColorBrush x:Key="Brush.TextSecondary">#C0C4C9</SolidColorBrush> <!-- Ink 3: inactive but readable, metadata -->
          <SolidColorBrush x:Key="Brush.TextMuted">#A4A9B0</SolidColorBrush>     <!-- Ink 4: explanations, units, hints -->
          <SolidColorBrush x:Key="Brush.TextTertiary">#92969D</SolidColorBrush>  <!-- Ink 5: caps labels above parameters -->
          <SolidColorBrush x:Key="Brush.TextDisabled">#82868C</SolidColorBrush>  <!-- Ink 6: search placeholder, disabled action -->
          <SolidColorBrush x:Key="Brush.TextAxis">#82868C</SolidColorBrush>      <!-- Ink 7: axis labels inside graphs only, mono 7-8px -->
          <SolidColorBrush x:Key="Brush.TextOnAccent">#17181A</SolidColorBrush>

          <!-- === Accent: Studio orange, the one accent. Live or chosen — playing,
               selected, looping, toggled on, a control while dragged — and nothing else.
               A second accent must never enter the system. === -->
          <SolidColorBrush x:Key="Brush.Accent">#FF9F1C</SolidColorBrush>        <!-- playhead, selection, toggled-on fill -->
          <SolidColorBrush x:Key="Brush.AccentBright">#FFB547</SolidColorBrush>  <!-- accent glow: the line / ink variant -->
          <SolidColorBrush x:Key="Brush.AccentHover">#FFB547</SolidColorBrush>   <!-- accent text on hover -->
          <SolidColorBrush x:Key="Brush.AccentDeep">#C77612</SolidColorBrush>    <!-- press, left half of the loop -->
          <SolidColorBrush x:Key="Brush.AccentDim">#C77612</SolidColorBrush>     <!-- the soft / pressed accent -->
          <SolidColorBrush x:Key="Brush.AccentEdge">#BF7D22</SolidColorBrush>    <!-- accent line -->
          <SolidColorBrush x:Key="Brush.AccentSubtle">#4D3F2E</SolidColorBrush>  <!-- accent-soft: 16% accent over the panel -->

          <!-- === Semantic: by purpose only === -->
          <SolidColorBrush x:Key="Brush.Record">#F06A6E</SolidColorBrush>        <!-- active recording. The only claim on red. -->
          <SolidColorBrush x:Key="Brush.RecordInk">#17181A</SolidColorBrush>     <!-- the disc on an engaged record button: dark on the light Dark-theme red -->
          <SolidColorBrush x:Key="Brush.Danger">#F06A6E</SolidColorBrush>        <!-- Alert: overload, clipping -->
          <SolidColorBrush x:Key="Brush.DangerHover">#F48386</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.DangerBright">#F58F92</SolidColorBrush>  <!-- Alert Light: overload readout text on dark -->
          <SolidColorBrush x:Key="Brush.DangerSubtle">#33F06A6E</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Warning">#F2B53C</SolidColorBrush>       <!-- Caution: meter -6..0 dB -->
          <SolidColorBrush x:Key="Brush.Success">#6CC673</SolidColorBrush>       <!-- Signal: working meter zone -->
          <SolidColorBrush x:Key="Brush.SuccessInk">#17181A</SolidColorBrush>    <!-- ink on a Success fill (Session play) -->
          <SolidColorBrush x:Key="Brush.SuccessDim">#3F8A45</SolidColorBrush>    <!-- Signal Dim: transport input, metronome -->

          <!-- === Role chromas: inside visualisers only, never on a button ===
               When two or three sources share one graph they take these in order. -->
          <SolidColorBrush x:Key="Brush.ChromaTeal">#5FB3A8</SolidColorBrush>    <!-- 2nd layer: lows, early reflections, input -->
          <SolidColorBrush x:Key="Brush.ChromaTealLight">#86C9C0</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ChromaRose">#D77A8F</SolidColorBrush>    <!-- 3rd layer: right channel, highs, tail -->
          <SolidColorBrush x:Key="Brush.ChromaRoseLight">#E49EAE</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ChromaSteel">#6A9FD8</SolidColorBrush>   <!-- 4th layer, used rarely -->

          <!-- Retint Fluent's built-in accent (slider fills, checkboxes, focus) to the
               orange so stock controls match the palette instead of the default blue. -->
          <Color x:Key="SystemAccentColor">#FF9F1C</Color>
          <Color x:Key="SystemAccentColorLight1">#FFAB37</Color>
          <Color x:Key="SystemAccentColorLight2">#FFB652</Color>
          <Color x:Key="SystemAccentColorLight3">#FFC26E</Color>
          <Color x:Key="SystemAccentColorDark1">#E68F19</Color>
          <Color x:Key="SystemAccentColorDark2">#CC7F16</Color>
          <Color x:Key="SystemAccentColorDark3">#B26F14</Color>

          <!-- === Track palette: nine roles, one lightness, no track louder than
               another. A group sets the hue; its tracks take neighbouring shades. -->
          <!-- Roles the earlier palette lacked: seam / rule, faint ink, mute amber, solo blue,
               and the neutral ink graphs draw in at rest. -->
          <SolidColorBrush x:Key="Brush.Seam">#141517</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Rule">#45484E</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextFaint">#82868C</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Mute">#F2B53C</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Solo">#6A9FD8</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.VizInk">#D7D8DA</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.VizGrid">#2E2F32</SolidColorBrush>

          <SolidColorBrush x:Key="Brush.Track1">#7FB87A</SolidColorBrush> <!-- Drums -->
          <SolidColorBrush x:Key="Brush.Track2">#5FB3A8</SolidColorBrush> <!-- Perc -->
          <SolidColorBrush x:Key="Brush.Track3">#5AA6C4</SolidColorBrush> <!-- Bass -->
          <SolidColorBrush x:Key="Brush.Track4">#6A9FD8</SolidColorBrush> <!-- Keys -->
          <SolidColorBrush x:Key="Brush.Track5">#E0A84A</SolidColorBrush> <!-- Texture -->
          <SolidColorBrush x:Key="Brush.Track6">#9D90C9</SolidColorBrush> <!-- FX -->
          <SolidColorBrush x:Key="Brush.Track7">#D77A8F</SolidColorBrush> <!-- Brass -->
          <SolidColorBrush x:Key="Brush.Track8">#B3B45E</SolidColorBrush> <!-- Vox -->
          <SolidColorBrush x:Key="Brush.Track9">#8E9DB0</SolidColorBrush> <!-- Return -->
          <SolidColorBrush x:Key="Brush.ReturnA">#8E9DB0</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ReturnB">#7A889A</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Master">#A4A9B0</SolidColorBrush>

          <!-- Depth (Saine): a raised control carries a faint top bevel and a seam ring; a
               recessed field an inset rule. Only floating layers (menus, popovers, tooltips,
               modals) cast a blurred shadow — anything docked is flat. -->
          <BoxShadows x:Key="Shadow.Sunken">inset 0 0 0 1 #45484E</BoxShadows>
          <BoxShadows x:Key="Shadow.Raised">inset 0 1 0 0 #12FFFFFF</BoxShadows>
          <BoxShadows x:Key="Shadow.Popover">0 0 0 1 #141517, 0 10 28 0 #6B000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Modal">0 0 0 1 #141517, 0 24 64 0 #80000000</BoxShadows>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <!-- Light: Saine's light preset. Same roles in light greys; the seam stays darker
               than the panel and the rule lighter than the seam, as in the dark set. -->
          <SolidColorBrush x:Key="Brush.SurfaceAbyss">#D6D8DB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.BgApp">#C9CBCF</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Gutter">#9DA0A6</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.BgSunken">#D6D8DB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Panel">#E4E5E7</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SurfaceCard">#E4E5E7</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SurfaceInset">#DCDEE0</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SurfaceRaised">#EEEFF1</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SurfaceHover">#F7F8F9</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SurfaceHoverClear">#00F7F8F9</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TrackOff">#D6D8DB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SurfaceActive">#D6D8DB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.LaneB">#C4C6CA</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ChromeBg">#D6D8DB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SurfaceSelected">#F7F8F9</SolidColorBrush>

          <!-- Lines and frames -->
          <SolidColorBrush x:Key="Brush.Hairline">#B3B6BB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.BorderDefault">#9DA0A6</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.BorderStrong">#B3B6BB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.BorderBrass">#ECA54E</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.GridBeat">#BDC0C4</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.GridBar">#ADB0B5</SolidColorBrush>

          <!-- Text: warm near-black, same eight steps -->
          <SolidColorBrush x:Key="Brush.TextHeading">#0E0F11</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextPrimary">#16171A</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextStrong">#282A2E</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextSecondary">#3A3D42</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextMuted">#4F535A</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextTertiary">#65696F</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextDisabled">#797C81</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextAxis">#797C81</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextOnAccent">#17181A</SolidColorBrush>

          <!-- Accent: a deeper orange so it holds contrast on pale grey -->
          <SolidColorBrush x:Key="Brush.Accent">#EF8A0C</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.AccentBright">#C46A00</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.AccentHover">#C46A00</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.AccentDeep">#D47800</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.AccentDim">#F7C27A</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.AccentEdge">#ECA54E</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.AccentSubtle">#E6D6C4</SolidColorBrush>

          <!-- Semantic -->
          <SolidColorBrush x:Key="Brush.Record">#B3262C</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.RecordInk">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Danger">#B3262C</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.DangerHover">#C2343A</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.DangerBright">#9C1F24</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.DangerSubtle">#33B3262C</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Warning">#7A4F00</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Success">#22692B</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SuccessInk">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.SuccessDim">#79B880</SolidColorBrush>

          <!-- Role chromas -->
          <SolidColorBrush x:Key="Brush.ChromaTeal">#3A8A7F</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ChromaTealLight">#2E7067</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ChromaRose">#B4566B</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ChromaRoseLight">#93404F</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ChromaSteel">#3F78B8</SolidColorBrush>

          <Color x:Key="SystemAccentColor">#EF8A0C</Color>
          <Color x:Key="SystemAccentColorLight1">#F19829</Color>
          <Color x:Key="SystemAccentColorLight2">#F3A646</Color>
          <Color x:Key="SystemAccentColorLight3">#F5B463</Color>
          <Color x:Key="SystemAccentColorDark1">#D77C0B</Color>
          <Color x:Key="SystemAccentColorDark2">#BF6E0A</Color>
          <Color x:Key="SystemAccentColorDark3">#A76108</Color>

          <!-- Track palette — the same nine roles, darkened so a clip's content reads -->
          <!-- Roles the earlier palette lacked: seam / rule, faint ink, mute amber, solo blue,
               and the neutral ink graphs draw in at rest. -->
          <SolidColorBrush x:Key="Brush.Seam">#9DA0A6</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Rule">#B3B6BB</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TextFaint">#797C81</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Mute">#7A4F00</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Solo">#3F78B8</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.VizInk">#252629</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.VizGrid">#C0C3C6</SolidColorBrush>

          <SolidColorBrush x:Key="Brush.Track1">#4A7F46</SolidColorBrush> <!-- Drums -->
          <SolidColorBrush x:Key="Brush.Track2">#3A8A7F</SolidColorBrush> <!-- Perc -->
          <SolidColorBrush x:Key="Brush.Track3">#357C99</SolidColorBrush> <!-- Bass -->
          <SolidColorBrush x:Key="Brush.Track4">#3F78B8</SolidColorBrush> <!-- Keys -->
          <SolidColorBrush x:Key="Brush.Track5">#B8862F</SolidColorBrush> <!-- Texture -->
          <SolidColorBrush x:Key="Brush.Track6">#7363A8</SolidColorBrush> <!-- FX -->
          <SolidColorBrush x:Key="Brush.Track7">#B4566B</SolidColorBrush> <!-- Brass -->
          <SolidColorBrush x:Key="Brush.Track8">#7E7F2F</SolidColorBrush> <!-- Vox -->
          <SolidColorBrush x:Key="Brush.Track9">#5D6C80</SolidColorBrush> <!-- Return -->
          <SolidColorBrush x:Key="Brush.ReturnA">#5D6C80</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.ReturnB">#4E5B6D</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.Master">#4F535A</SolidColorBrush>

          <BoxShadows x:Key="Shadow.Sunken">inset 0 0 0 1 #B3B6BB</BoxShadows>
          <BoxShadows x:Key="Shadow.Raised">inset 0 1 0 0 #B3FFFFFF</BoxShadows>
          <BoxShadows x:Key="Shadow.Popover">0 0 0 1 #9DA0A6, 0 10 28 0 #381E2024</BoxShadows>
          <BoxShadows x:Key="Shadow.Modal">0 0 0 1 #9DA0A6, 0 24 64 0 #401E2024</BoxShadows>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===== Motion (Saine § Knob dial: 120ms ease-out) =====================================================
       Hover and colour change over 120ms ease-out; nothing moves or scales. Real-time views
       (meters, playhead, spectra) are custom-drawn and never animate. -->
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="CheckBox /template/ Border#Track">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <!-- Toolbar/transport buttons stay out of the keyboard focus + Tab order so global
         hotkeys (Space/R/L/Return/…) always reach the window, never a focused button. -->
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Height" Value="{StaticResource Control.Shell}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <!-- A raised face carries a 1px inner highlight on top (Shadow.Raised). The presenter
         paints the face, so the highlight rides an overlay above it; styles hide it
         wherever the face is not raised (pressed, solid accent, ghost, engaged). -->
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          <Border x:Name="PART_Lift" CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource Shadow.Raised}" IsHitTestVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <!-- Pressed goes into the recess: the ground changes, nothing moves. -->
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceActive}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="Button:pressed /template/ Border#PART_Lift, Button:disabled /template/ Border#PART_Lift,
                   Button.ghost /template/ Border#PART_Lift,
                   Button.tp-play.playing /template/ Border#PART_Lift, Button.cell /template/ Border#PART_Lift">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <!-- Disabled: the ground drops to the panel colour and the text to faint — never opacity. -->
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
  </Style>

  <!-- The primary action of a context is set apart by weight and one tone step, not by
       colour: orange is kept for what is live or chosen (Saine § Buttons). -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextHeading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextHeading}"/>
  </Style>

  <Style Selector="Button.ghost">
    <!-- Hover colour at zero alpha, not Transparent (#00FFFFFF): see ListBoxItem. -->
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHoverClear}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
  </Style>

  <!-- .danger no longer paints red: red belongs to recording and errors. A destructive
       action is an ordinary raised button; its label says what it does. -->

  <!-- ===== Toggle buttons ===== -->
  <Style Selector="ToggleButton">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Height" Value="{StaticResource Control.Shell}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <!-- A raised face carries a 1px inner highlight on top (Shadow.Raised). The presenter
         paints the face, so the highlight rides an overlay above it; styles hide it
         wherever the face is not raised (pressed, solid accent, ghost, engaged). -->
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          <Border x:Name="PART_Lift" CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource Shadow.Raised}" IsHitTestVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton:checked /template/ Border#PART_Lift, ToggleButton:pressed /template/ Border#PART_Lift,
                   ToggleButton:disabled /template/ Border#PART_Lift, ToggleButton.seg /template/ Border#PART_Lift,
                   ToggleButton.cell /template/ Border#PART_Lift">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceActive}"/>
  </Style>
  <Style Selector="ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
  </Style>
  <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
  </Style>
  <!-- Toggled on: a solid accent key with derived dark ink (Saine § Buttons — "active").
       Hover keeps it: the state, not the pointer, owns the colour. -->
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>
  <Style Selector="ToggleButton:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>
  <!-- Record: danger tint when engaged -->
  <Style Selector="ToggleButton.danger:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.RecordInk}"/>   <!-- beats the checked presenter's on-accent ink -->
  </Style>
  <Style Selector="ToggleButton.danger:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.RecordInk}"/>
  </Style>

  <!-- ===== Transport / toolbar chrome ===== -->
  <!-- 26px transport keys: raised, seam edge, bevel (Saine § Buttons) -->
  <Style Selector="Button.tp-icon, ToggleButton.tp-icon">
    <Setter Property="Width" Value="{StaticResource Control.Transport}"/>
    <Setter Property="Height" Value="{StaticResource Control.Transport}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <!-- Record: at rest a neutral button with a red disc; engaged, solid record red with a
       pale disc. The only place red fills a control. -->
  <Style Selector="ToggleButton.tp-icon.rec">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Record}"/>
  </Style>
  <Style Selector="ToggleButton.tp-icon.rec:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Record}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Record}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.RecordInk}"/>   <!-- beats the checked presenter's on-accent ink -->
  </Style>
  <Style Selector="ToggleButton.tp-icon.rec:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.RecordInk}"/>
  </Style>
  <!-- Play: a raised key like its neighbours at rest, wider; while the transport runs it is
       a solid accent key (live). -->
  <Style Selector="Button.tp-play">
    <Setter Property="Width" Value="{StaticResource Control.Play}"/>
    <Setter Property="Height" Value="{StaticResource Control.Transport}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.tp-play.playing">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>
  <Style Selector="Button.tp-play.playing:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>
  <!-- Play turns green in the Session context -->
  <Style Selector="Button.tp-play.playing.session">
    <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessInk}"/>
  </Style>
  <Style Selector="Button.tp-play.playing.session:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessInk}"/>
  </Style>

  <!-- Chips: raised keys like any button, a little tighter (Saine § Chips). -->
  <Style Selector="Button.chip, ToggleButton.chip">
    <Setter Property="Height" Value="{StaticResource Control.Shell}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Engaged chip (MIDI learn…). The .chip Foreground above is a class selector declared
       after the generic ToggleButton:checked rule, so it would win on a checked chip;
       state the derived ink here. -->
  <Style Selector="ToggleButton.chip:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <!-- Fluent's checked template paints the presenter itself, which beats the
         control-level Foreground above. -->
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>

  <!-- A chip lit by a running feature (Remote on): live, so a solid accent key. -->
  <Style Selector="Button.chip.lit">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="Button.chip.lit /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>
  <Style Selector="Button.chip.lit /template/ Border#PART_Lift">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!-- A readout well (BPM, signature): recessed, 26px, a 1px rule edge (Saine § Inputs). -->
  <Style Selector="Border.well">
    <Setter Property="Height" Value="{StaticResource Control.Shell}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- BPM field inside a well: flat, vertically centred, no focus-grow -->
  <Style Selector="NumericUpDown.bpm">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="NumericUpDown.bpm /template/ TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="NumericUpDown.bpm /template/ TextBox /template/ Border#PART_BorderElement">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- The transport row: a flat, docked 44px strip on the panel tone with a seam under
       it (Saine § Layout — the transport row of the top chrome). -->
  <Style Selector="Border.transport">
    <Setter Property="Height" Value="{StaticResource Control.TransportBar}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Docked}"/>
  </Style>
  <!-- Transport · position · loop: one 30px recessed group in the row, so playback reads
       as one object instead of three neighbours. -->
  <Style Selector="Border.console">
    <Setter Property="Height" Value="{StaticResource Control.Console}"/>
    <Setter Property="Padding" Value="2,0,8,0"/>
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- A clickable readout (tap / key / grid / loop): a 26px well holding a mono value and
       its muted unit on one line, the way Saine sets "120.0 BPM". -->
  <Style Selector="Button.cell, ToggleButton.cell">
    <Setter Property="Height" Value="{StaticResource Control.Shell}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.cell:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
  </Style>
  <Style Selector="Button.cell:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
  </Style>
  <!-- On (loop): a solid accent key with derived ink, like any toggled-on key. -->
  <Style Selector="ToggleButton.cell:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="ToggleButton.cell:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>

  <!-- Segmented group (view switch, mode tabs): raised keys butted square against 1px
       seams; only the group's outer corners round (Saine § Shapes). The group's ground is
       the seam, so the spacing between keys draws the seams. -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.segmented StackPanel">
    <Setter Property="Spacing" Value="1"/>
  </Style>
  <!-- The master well in the transport row: recessed like the console. -->
  <Style Selector="Border.transport Border.tp-well">
    <Setter Property="Height" Value="{StaticResource Control.Console}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.seg">
    <Setter Property="Height" Value="{StaticResource Control.Seg}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
  </Style>
  <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <!-- Derived ink on the accent fill; set on the presenter so Fluent's checked
         foreground doesn't win over the control-level Foreground. -->
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>
  <Style Selector="ToggleButton.seg:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.seg:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
  </Style>

  <!-- ===== ComboBox — a recessed field (Saine § Inputs) ===== -->
  <Style Selector="ComboBox">
    <Setter Property="Height" Value="{StaticResource Control.Shell}"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Brush.TextTertiary}"/>
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
  </Style>
  <Style Selector="ComboBox:focus /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="ComboBox /template/ PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
  </Style>
  <!-- dropdown flyout + items -->
  <Style Selector="ComboBox /template/ Popup Border">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Clip}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
  </Style>
  <!-- Hover is a full accent fill with derived ink, like a menu item (Saine § Navigation). -->
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>

  <!-- ===== CheckBox — drawn as a latching switch ================================
       An on/off choice is an 18×10 track with a 7px knob inset 1.5, its word to the
       right — 12px in the shell. Square-cornered like every Saine key; on is the accent
       (chosen). Disabled takes the faint ink and the panel ground, never opacity. -->
  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Border x:Name="Track" Width="18" Height="10" VerticalAlignment="Center"
                  CornerRadius="{StaticResource Radius.Pill}"
                  Background="{DynamicResource Brush.TrackOff}"
                  BorderBrush="Transparent" BorderThickness="1">
            <Rectangle x:Name="Knob" Width="7" Height="7" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="0.5,0,0,0" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource Brush.TextTertiary}"/>
          </Border>
          <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="CheckBox:checked /template/ Rectangle#Knob">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,0,0.5,0"/>
    <Setter Property="Fill" Value="{DynamicResource Brush.Panel}"/>
  </Style>
  <Style Selector="CheckBox:indeterminate /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource Brush.BorderStrong}"/>
  </Style>
  <Style Selector="CheckBox:indeterminate /template/ Rectangle#Knob">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="CheckBox:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="CheckBox:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="CheckBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
  </Style>
  <Style Selector="CheckBox:disabled /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
  </Style>
  <Style Selector="CheckBox:disabled /template/ Rectangle#Knob">
    <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
  </Style>

  <!-- ===== Form text field (recessed, matches the ComboBox field) =====
       Opt-in via Classes="field" — the plain TextBox stays the Fluent default so
       inline editors (rename popups, macro names) keep their flat look. -->
  <Style Selector="TextBox.field">
    <Setter Property="Height" Value="{StaticResource Control.Shell}"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
  </Style>

  <!-- ===== Keyboard focus: a 1px accent edge, no ring and no glow (Saine § Inputs) ===== -->
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="ToggleButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="CheckBox:focus-visible /template/ Border#Track">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
  </Style>

  <!-- ===== Text roles ===== -->
  <!-- ===== Type ============================================================
       Saine's hierarchy: nothing in the shell is larger than 13 except the position
       readout; chrome text is 11–12. Device text sits lower (8–10.5) because a card keeps
       Nota's 260px frame. Labels are sentence case at letter-spacing 0 — no uppercase
       tracked labels anywhere (Saine "No Shouting"); NotaText.Label turns the caps
       strings views still pass into sentence case. Mono means a number you read.
       Mirrored as constants in Theme/NotaFonts.cs (NotaType). -->

  <!-- Shell scale -->
  <Style Selector="TextBlock.Title">          <!-- modal / section heading: 13 / 600 -->
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextHeading}"/>
  </Style>
  <Style Selector="TextBlock.Heading">        <!-- project name: 13 / 600 -->
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="TextBlock.Name">           <!-- track, preset, file name: 12 / 500 -->
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="TextBlock.Caption">        <!-- supporting copy, hint: 11 / 400 / 1.5, secondary -->
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.SectionLabel">   <!-- panel group heading: 11 / 600, muted, sentence case -->
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
  </Style>
  <!-- The unit beside a readout (BPM, Loop, Grid): Saine sets it in Geist 500 10px muted. -->
  <Style Selector="TextBlock.CellLabel">      <!-- 10 / 500, muted -->
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="LineHeight" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
  </Style>
  <Style Selector="TextBlock.Mono">           <!-- family only; size comes from the role -->
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
  </Style>
  <Style Selector="TextBlock.Readout">        <!-- transport numbers: mono 13 / 400 -->
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="TextBlock.Value">          <!-- value in a row, metadata: mono 11 / 400 -->
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.Eyebrow">        <!-- format badge: mono 10 / 400, muted, as written -->
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
  </Style>

  <!-- Device scale (inside a 260px card) -->
  <Style Selector="TextBlock.DeviceName">     <!-- 12 / 600 -->
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="TextBlock.DeviceSection">  <!-- section title: 10.5 / 600, muted -->
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
  </Style>
  <Style Selector="TextBlock.RowLabel">       <!-- slider-row label: 9 / 500 -->
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.KnobLabel">      <!-- the control's name: 8 / 500 -->
    <Setter Property="FontSize" Value="8"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="LineHeight" Value="9"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.KnobValue">      <!-- parameter value: mono 8 -->
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="8"/>
    <Setter Property="LineHeight" Value="10"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="TextBlock.Axis">           <!-- tick label inside a graph: mono 7.5 -->
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="7.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextAxis}"/>
  </Style>

  <!-- ===== Containers ===== -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
    <Setter Property="Padding" Value="10"/>
  </Style>
  <Style Selector="Border.Panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!-- ===== Lists ===== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource Brush.BgSunken}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
  </Style>
  <!-- A list row: 26px, one line of text. Selected = raised hover + a 2px accent tick. -->
  <Style Selector="ListBoxItem">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="{StaticResource Control.Shell}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Clip}"/>
    <!-- Not Transparent: that is #00FFFFFF, and the 120ms brush fade to a dark hover
         would pass through a translucent white — a visible flash on every hover. -->
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHoverClear}"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>

  <!-- ===== Tabs ===== -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <!-- Tabs: 12 / 500 secondary; the selected tab is primary ink over a 2px accent
       underline, not a fill (Saine § Navigation). -->
  <Style Selector="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="4,4"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
  </Style>

  <!-- ===== Browser icon rail (custom vertical tabs) ===== -->
  <!-- Full-bleed 36px tab in a 40px rail; the active one is marked by a 2px accent edge
       on the left and an accent icon rather than a filled chip, so the rail stays quiet. -->
  <Style Selector="Border.RailTab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Height" Value="36"/>
  </Style>
  <Style Selector="Border.RailTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
  </Style>
  <Style Selector="Border.RailTab Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="Border.RailTab.active Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.AccentBright}"/>
  </Style>
  <!-- The active edge: a 2px accent bar inset from the tab's top and bottom. -->
  <Style Selector="Border.RailBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="2"/>
    <Setter Property="Margin" Value="0,6"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Clip}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="Border.RailTab.active Border.RailBar">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
  </Style>

  <!-- ===== Browser list (compact index rows, mockup 1a) ===== -->
  <!-- Single-line 24px rows, full-bleed: the selection ground and its accent left edge run
       to both margins, so the list reads as one column rather than a stack of chips. -->
  <Style Selector="ListBox.browser">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.browser ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="ListBox.browser ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
  </Style>
  <Style Selector="ListBox.browser ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/>
  </Style>
  <!-- Row parts. Colours live here (not on the element) so selection can override them:
       a local value would outrank the style setter. -->
  <Style Selector="Border.RowEdge">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="2"/>
  </Style>
  <Style Selector="ListBoxItem:selected Border.RowEdge">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="TextBlock.RowName">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>
  <Style Selector="TextBlock.RowName.child">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.RowPrefix">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
  </Style>
  <!-- Row metadata on the right: mono, like every other measurement-ish value. -->
  <Style Selector="TextBlock.RowTag">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.RowTag">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.GroupLabel">     <!-- browser section: 11 / 600, muted, sentence case -->
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
  </Style>

  <!-- ===== Flat search box ===== -->
  <!-- Used inside a bordered wrapper (see BrowserView), so the TextBox itself must
       stay flat: no min-height jump, no focus background/border of its own. -->
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ===== Menus, flyouts, drop-downs, tooltips: floating layers =====
       Raised grey, 3px corners, a seam ring. Avalonia draws each popup in a window of its
       own, sized to its content, so a blurred shadow would be clipped at the popup's edge;
       these carry the seam ring only, and Shadow.Popover / Shadow.Modal are for overlays
       drawn inside the main window (command palette). Menu items are 24px; hover is a
       full accent fill with derived ink. -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Padding" Value="4"/>
  </Style>
  <!-- A plain flyout (a popover with its own content). -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
  </Style>
  <!-- A flyout whose content draws its own card (Connect Phone): no frame around it. -->
  <Style Selector="FlyoutPresenter.bare">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MaxWidth" Value="480"/>
    <Setter Property="MaxHeight" Value="720"/>
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Padding" Value="4"/>
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="8,0"/>
  </Style>
  <!-- Root Border of the MenuItem template: transparent by default, a full accent fill on
       highlight (Avalonia marks the hovered flyout item :selected). -->
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Clip}"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot,
                   MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="MenuItem:selected, MenuItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
  </Style>
  <Style Selector="MenuItem:disabled /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- Shortcut on the right of an item (MenuItem.InputGesture): muted ink — the next ink
       step, not opacity — and the derived ink while the item is highlighted. -->
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
    <Setter Property="Margin" Value="20,0,0,0"/>
  </Style>
  <Style Selector="MenuItem:selected /template/ TextBlock#PART_InputGestureText,
                   MenuItem:pointerover /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
  </Style>

  <!-- The menubar's own triggers (File, Edit…): secondary ink that lifts to the raised tone
       on hover or while open — only the items inside a menu fill with the accent. -->
  <Style Selector="Menu > MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="22"/>
  </Style>
  <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot,
                   Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot,
                   Menu > MenuItem:open /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
  </Style>
  <Style Selector="Menu > MenuItem:selected, Menu > MenuItem:pointerover, Menu > MenuItem:open">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="4,4"/>
  </Style>

  <!-- Tooltip: a small raised popover, primary ink, 11px. -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Seam}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <!-- ===== Scrollbars: a thin muted thumb on a transparent track (Saine) ===== -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="9"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="9"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.Rule}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
    <Setter Property="MinWidth" Value="5"/>
    <Setter Property="MinHeight" Value="5"/>
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.TextFaint}"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.TextMuted}"/>
  </Style>
  <!-- Track buttons (the little arrows) are noise at this scale — hide them. -->
  <Style Selector="ScrollBar /template/ RepeatButton">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
</Styles>
